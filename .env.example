# Server-side configuration, read by server/ and never sent to the browser.
# Local development: copy this file to .env, fill in the values, restart `npm start`.
# Production: set the same variables in the Vercel project settings.

# Satflow API key (collections, listings, purchases, bids)
SATFLOW_API_KEY=your_satflow_api_key_here

# UniSat Open API key (inscription/UTXO scanning; unauthenticated requests get 403)
# Free key: https://developer.unisat.io/
UNISAT_API_KEY=your_unisat_api_key_here

# Optional: extra browser origins allowed to call /api/* (comma-separated).
# The site's own origin is always allowed; requests from other websites get 403.
# ALLOWED_ORIGINS=https://staging.example.com
