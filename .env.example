# Server-side API keys, read by server/ and never sent to the browser.
# Local development: copy this file to .env, fill in the keys, restart `npm start`.
# Production: set the same variables in the Vercel project settings.

# Satflow API key (collections, listings, purchases, bids)
SATFLOW_API_KEY=your_satflow_api_key_here

# UniSat Open API key (inscription/UTXO scanning; unauthenticated requests get 403)
# Free key: https://developer.unisat.io/
UNISAT_API_KEY=your_unisat_api_key_here

# Optional, browser-side: Hiro API key for the inscriptions panel on /home.
# REACT_APP_* values are embedded in the public bundle, so treat this key as public.
# REACT_APP_HIRO_API_KEY=
