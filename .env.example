# Magic Eden API Key
# Get your API key from: https://magiceden.io/developers
MAGIC_EDEN_API_KEY=your_magic_eden_api_key_here
# UniSat Open API (Ordinal Extractor — scan inscription UTXOs)
# Required: unauthenticated requests are rate-limited (403). Free key: https://developer.unisat.io/
UNISAT_API_KEY=your_unisat_api_key_here
# React App Environment
NODE_ENV=development
